# ==============================================================================
# Local development (docker compose, no GCP). Copied to .env.development by `make up-dev`.
# Fill in at least one LLM API key. NEVER commit the real file (it is gitignored).
# ==============================================================================
ENVIRONMENT=development
SECURITY_MODE=local_mock

# LLM: litellm tries groq -> nvidia -> vertexai -> openrouter, using whichever has credentials
LLM_PROVIDER=litellm
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Orchestrator model (empty = same as LLM_*). The 3.1 attack depends on the model: see docs/modelos_probados.md
ORCHESTRATOR_PROVIDER=openrouter
ORCHESTRATOR_MODEL=nvidia/nemotron-3.5-super-vl:free

# Local-only secret; production refuses to start with it
TOKEN_VAULT_SECRET=development-secret-key-32-chars!

# Controls
USE_GCS_INGESTION=false
USE_GCP_MODEL_ARMOR=false
PDP_FALLBACK_MODE=deny
CHECKPOINTER_TYPE=memory

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=financial-assistant-agents

VITE_API_BASE_URL=http://localhost:8000
