# ==============================================================================
# GCP live mode (real Cloud DLP / Model Armor / Vertex AI). Copy to .env.production and complete.
# NEVER commit the real file. This PoC is deliberately vulnerable: do not deploy it with real credentials or funds.
# ==============================================================================
ENVIRONMENT=production
SECURITY_MODE=gcp_live

GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
VERTEX_MODEL_NAME=gemini-1.5-flash-002
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

LLM_PROVIDER=vertexai
LLM_MODEL=

# REQUIRED: the backend refuses to start in production with the default secret
TOKEN_VAULT_SECRET=

# Real Model Armor (template created in your project; see docs/gcp_deployment_and_iam.md)
USE_GCP_MODEL_ARMOR=true
MODEL_ARMOR_TEMPLATE_ID=

# Optional: read the attachment from a bucket instead of backend/local_storage
USE_GCS_INGESTION=false
GCS_BUCKET_NAME=

PDP_FALLBACK_MODE=deny
# NOTE: CHECKPOINTER_TYPE=firestore currently falls back to MemorySaver (see docs/architecture.md)
CHECKPOINTER_TYPE=memory

VITE_API_BASE_URL=http://localhost:8000
