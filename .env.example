# ==============================================================================
# Financial Assistant Defense-in-Depth - Root Environment Template
# ==============================================================================

# Application & Environment
APP_NAME="Financial Assistant Multi-Agent API"
ENVIRONMENT=development
DEBUG=True

# Security Mode: local_mock | gcp_live
SECURITY_MODE=local_mock

# LLM Provider: litellm (fallback chain) | groq | nvidia | vertexai | openrouter | google_genai
LLM_PROVIDER=litellm
LLM_MODEL=openai/gpt-oss-120b

# Orchestrator model override (optional; empty = same as LLM_PROVIDER/LLM_MODEL).
# Whether the 3.1 attack succeeds depends on the model: see docs/modelos_probados.md
ORCHESTRATOR_PROVIDER=openrouter
ORCHESTRATOR_MODEL=nvidia/nemotron-3.5-super-vl:free

# API Keys
GROQ_API_KEY=""
NVIDIA_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""

# Observability & Tracing (LangSmith / Langfuse)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT=financial-assistant-agents
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# Google Cloud Platform
GCP_PROJECT_ID="demo-fintech-project"
GCP_LOCATION="us-central1"
VERTEX_MODEL_NAME="gemini-1.5-flash-002"

# Persistence & Checkpointer
CHECKPOINTER_TYPE=memory
FIRESTORE_COLLECTION="langgraph_checkpoints"

# Security Token Vault
TOKEN_VAULT_SECRET="super-secret-vault-key-change-in-prod-32bytes!"

# Server Ports
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
