# ==============================================================================
# Financial Assistant Defense-in-Depth - Root Environment Template
# ==============================================================================

# Application & Environment
APP_NAME="Financial Assistant Multi-Agent API"
ENVIRONMENT=development
DEBUG=True

# Security Mode: local_mock | gcp_live
SECURITY_MODE=local_mock

# LLM Provider: litellm (fallback chain) | groq | nvidia | vertexai | openrouter | google_genai
LLM_PROVIDER=litellm
LLM_MODEL=openai/gpt-oss-120b

# Orchestrator model override (optional; empty = same as LLM_PROVIDER/LLM_MODEL).
# Whether the 3.1 attack succeeds depends on the model: see docs/modelos_probados.md
ORCHESTRATOR_PROVIDER=openrouter
ORCHESTRATOR_MODEL=nvidia/nemotron-3.5-super-vl:free

# API Keys
GROQ_API_KEY=""
NVIDIA_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""

# Observability & Tracing (LangSmith / Langfuse)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT=financial-assistant-agents
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# Google Cloud Platform
GCP_PROJECT_ID="demo-fintech-project"
GCP_LOCATION="us-central1"
VERTEX_MODEL_NAME="gemini-3.1-flash-lite"

# Persistence & Checkpointer
CHECKPOINTER_TYPE=memory
FIRESTORE_COLLECTION="langgraph_checkpoints"

# Security Token Vault. Default value is for local_mock ONLY: with ENVIRONMENT=production the backend
# refuses to start unless you set your own secret (>= 32 bytes).
TOKEN_VAULT_SECRET="super-secret-vault-key-change-in-prod-32bytes!"

# Document ingestion (attachment read by read_document_tool)
# false = backend/local_storage/comprobante.txt ; true = object from the GCS bucket (falls back to the local file)
USE_GCS_INGESTION=false
GCS_BUCKET_NAME=""
LOCAL_DOCUMENT_PATH="local_storage/comprobante.txt"

# Model Armor: false = local heuristics ; true = real GCP Model Armor (needs MODEL_ARMOR_TEMPLATE_ID and SECURITY_MODE=gcp_live)
USE_GCP_MODEL_ARMOR=false
MODEL_ARMOR_TEMPLATE_ID=""

# Policy Decision Point (OPA). In docker-compose the backend uses http://opa:8181/...
# PDP_FALLBACK_MODE when OPA is unreachable: deny (transfer fails) | hitl (human approval)
PDP_URL="http://localhost:8181/v1/data/transaction/decision"
PDP_TIMEOUT_SECONDS=3.0
PDP_FALLBACK_MODE=deny

# Orchestrator safety limits
ORCHESTRATOR_MAX_PLAN_STEPS=8
ORCHESTRATOR_MAX_TOOL_ITERATIONS=3

# Server Ports
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
