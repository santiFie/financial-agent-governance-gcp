# ==============================================================================
# Ejemplo de .env.gcp. NO lo copies a mano: `make build-gcp` genera el archivo real (gitignored) con tu proyecto,
# la plantilla de Model Armor, el bucket y un TOKEN_VAULT_SECRET propio, y lo mantiene actualizado.
# `make attack-gcp` lo carga en el entorno (tiene prioridad sobre .env).
# ==============================================================================
ENVIRONMENT=production
SECURITY_MODE=gcp_live

GCP_PROJECT_ID=tu-proyecto
GCP_LOCATION=us-central1            # DLP, Model Armor, Firestore y GCS

LLM_PROVIDER=vertexai               # solo Vertex AI, sin fallback a otros proveedores
LLM_MODEL=
VERTEX_MODEL_NAME=gemini-3.1-flash-lite
VERTEX_LOCATION=global              # este modelo solo respondió en "global"; lo confirma el smoke test

CHECKPOINTER_TYPE=firestore
FIRESTORE_COLLECTION=langgraph_checkpoints

USE_GCP_MODEL_ARMOR=true
MODEL_ARMOR_TEMPLATE_ID=fin-template

USE_GCS_INGESTION=true              # make attack-gcp GCS=false lee el comprobante de backend/local_storage
GCS_BUCKET_NAME=tu-proyecto-fin-docs

PDP_FALLBACK_MODE=deny
TOKEN_VAULT_SECRET=                 # lo genera build-gcp (openssl rand -hex 32)
