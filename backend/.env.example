# ==============================================================================
# Financial Assistant Defense-in-Depth - Environment Variables
# ==============================================================================

# Application & Environment
APP_NAME="Financial Assistant Multi-Agent API"
ENVIRONMENT=development
DEBUG=True

# Security & Execution Mode:
# - local_mock: Local deterministic simulation (Regex DLP + Pattern Model Armor)
# - gcp_live: Real Cloud DLP API, Vertex AI Gemini, and Firestore
SECURITY_MODE=local_mock

# LLM Provider Configuration:
# - mock: Offline rule-based simulation (0 cost, no API keys required, ideal for unit tests)
# - groq: Ultra-fast free tier on console.groq.com (Llama 3.3 70B)
# - nvidia: NIM API on build.nvidia.com
# - vertexai: Google Cloud Vertex AI Gemini (requires GCP auth/credentials)
# - google_genai: Google AI Studio via GEMINI_API_KEY
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# API Keys (set according to chosen provider)
GROQ_API_KEY=""
NVIDIA_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""

# Observability & Tracing (LangSmith / Langfuse)
# Set LANGCHAIN_TRACING_V2=true and supply your LANGCHAIN_API_KEY for real-time trace telemetry
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT=financial-assistant-agents
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# Google Cloud Platform Configuration
GCP_PROJECT_ID="demo-fintech-project"
GCP_LOCATION="us-central1"
VERTEX_MODEL_NAME="gemini-3.1-flash-lite"

# LangGraph Checkpointer (State Persistence & HITL Breakpoints)
# - memory: In-memory MemorySaver (zero setup, ideal for local dev)
# - firestore: Cloud Firestore Native (scalable, persistent across server restarts)
CHECKPOINTER_TYPE=memory
FIRESTORE_COLLECTION="langgraph_checkpoints"

# Security: Secret key for Reversible TokenVault (HMAC-SHA256)
TOKEN_VAULT_SECRET="super-secret-vault-key-change-in-prod-32bytes!"

# Server Network Binding
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
